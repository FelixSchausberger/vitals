[Unit]
Description=Vitals System Monitoring Daemon
Documentation=https://github.com/schausberger/vitals
After=multi-user.target
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/vitals-daemon --mode live
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Security hardening
User=vitals
Group=vitals
# Socket at /run/vitals/daemon.sock (RuntimeDirectory= is exempt from
# ProtectSystem=strict, so it needs no ReadWritePaths= entry). The daemon has
# no SIGHUP handler, so there is deliberately no ExecReload=.
RuntimeDirectory=vitals
Environment=XDG_RUNTIME_DIR=/run
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Score history and config live under the service user's home.
ReadWritePaths=/var/lib/vitals
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=512M
TasksMax=100

# Environment
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target